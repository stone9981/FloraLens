<?xml version="1.0" encoding="utf-8"?>
<!--
  默认只允许 HTTPS；同时放行明文 HTTP，是为了让用户能连自己电脑上跑的
  本地大模型（Ollama / llama.cpp / LM Studio），这类服务通常只有 http://192.168.x.x:11434。
  如果不需要本地模型，把下面 domain-config 与 base-config 里的 cleartextTrafficPermitted
  都改成 false 即可收紧为纯 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 局域网内的自建推理服务 -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.2</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
    </domain-config>
</network-security-config>
