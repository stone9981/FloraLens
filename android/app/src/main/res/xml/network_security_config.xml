<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 HTTP，原因有二：
  1) 用户可能连本机/局域网自建大模型（Ollama / LM Studio / llama.cpp），
     这类服务通常只有 http://192.168.x.x:11434；
  2) 应用内 WebView 打开百度百科时，若词条不存在会被重定向到 http 的百度搜索页，
     禁止明文会直接报 net::ERR_CLEAR_TEXT_NOT_PERMITTED 而打不开网页。
  若不需要以上两者，把 cleartextTrafficPermitted 改回 false 即可收紧为纯 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
